# Скопируйте в .env. Не коммитьте реальный ключ.
OPENAI_API_KEY=
# Для OpenAI-совместимого провайдера можно указать base URL.
OPENAI_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=openrouter/free
# Модель эмбеддингов для semantic.py: имя на Hugging Face или локальный путь.
EMBED_MODEL=minishlab/potion-multilingual-128M
